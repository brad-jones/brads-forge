{
  "lineWidth": 120,
  "newLineKind": "lf",
  "useTabs": false,
  "incremental": true,
  "typescript": {
    "deno": true,
    "lineWidth": 120
  },
  "json": { "deno": true },
  "yaml": {},
  "toml": {},
  "markdown": {
    "deno": true
  },
  "excludes": [
    "**/.git",
    "**/.pixi",
    "**/.task",
    "**/apm_modules",
    "pixi.lock",
    "deno.lock",
    "apm.lock.yaml",
    "CHANGELOG.md"
  ],
  "plugins": [
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
